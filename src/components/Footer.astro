---
import CallToAction from './CallToAction.astro'
import ExternalLink from './ExternalLink.astro'
import Logo from './Logo.astro'

/**
 * Footer Component
 *
 * @description A component that displays the footer of the website
 */
const currentYear = new Date().getFullYear()
---

<footer>
  <CallToAction />
  <section class="py-20">
    <h2 class="sr-only">Footer</h2>
    <div class="container grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold">Movement</h3>
        <ul class="flex flex-col gap-2">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/stories">Stories</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/updates">Updates</a></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold">Get Involved</h3>
        <ul class="flex flex-col gap-2">
          <li><a href="/components-demo">Accessible Components Demo</a></li>
          <li><a href="/accessibility-statement">Accessibility Statement</a></li>
          <li><a href="/markdown-page">Markdown Page</a></li>
          <li><a href="/mdx-page">MDX Page</a></li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <h3 class="text-2xl font-bold">Movement Resources</h3>
        <ul class="flex flex-col gap-2">
          <li>
            <ExternalLink href="https://www.w3.org/WAI/ARIA/apg/">Web Accessibility</ExternalLink>
          </li>
          <li>
            <ExternalLink href="https://web.dev/articles/focus">Inclusive Design</ExternalLink>
          </li>
          <li>
            <ExternalLink href="https://github.com/barrettsoron/movement-starter-template"
              >Template Repository</ExternalLink
            >
          </li>
          <li>
            <ExternalLink href="https://astro.build/"
              >Astro Framework</ExternalLink
            >
          </li>
        </ul>
      </div>
      <div class="flex flex-col gap-4">
        <Logo loading="lazy" />
        <p class="leading-[1.75]">
          Building inclusive movements means creating websites accessible to all community members. This template prioritizes accessibility and rapid deployment for campaigns.
        </p>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container flex flex-col gap-4 md:flex-row md:justify-between">
      <p>
        &copy; {currentYear} - Movement Starter Template by <a href="https://github.com/barrettsoron">Mike Barrett Soron</a>.
      </p>
      <p>
        Built for organizing with ⚡ Based on <a href="https://github.com/incluud/accessible-astro-starter">Accessible Astro Starter</a>.
      </p>
    </div>
  </section>
</footer>

<style>
  section {
    border-top: 1px solid var(--border-color-subtle);
  }
</style>
