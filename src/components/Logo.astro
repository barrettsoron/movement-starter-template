---
import { Icon } from 'astro-icon/components'

/**
 * Logo Component
 *
 * @description Logo description
 */
interface Props {
  /**
   * Size of the logo icon
   * @default 40
   */
  size?: number
}

const { size = 40 }: Props = Astro.props
---

<a href="/" class="flex items-center gap-2 !no-underline">
  <Icon name="ph:users-three" size={size} class="logo-icon" />
  <span class="font-bold">Movement Starter</span>
</a>

<style lang="scss">
  a {
    color: var(--foreground-color);
    
    .logo-icon {
      color: var(--brand-primary);
      
      // Add a subtle glow/shadow effect for extra visual interest
      filter: drop-shadow(0 0 2px rgba(230, 57, 70, 0.3));
      
      &:hover {
        color: var(--brand-secondary);
        filter: drop-shadow(0 0 4px rgba(247, 127, 0, 0.4));
        transition: all 0.3s ease;
      }
    }
  }
</style>
