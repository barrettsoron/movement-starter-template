---
// Export all Accessible Astro Components for easy importing
// Import like: import { Accordion, Card, Modal } from '@components/AccessibleComponents.astro';

export { 
  Accordion,
  AccordionItem,
  Avatar,
  AvatarGroup,
  Badge,
  Breadcrumbs,
  BreadcrumbsItem,
  Card,
  DarkMode,
  Media,
  Modal,
  Notification,
  Pagination,
  SkipLink,
  Tabs,
  TabsList,
  TabsPanel,
  TabsTab,
  Video
} from 'accessible-astro-components';

// Also export commonly used project components
export { default as CallToAction } from './CallToAction.astro';
export { default as ContentMedia } from './ContentMedia.astro';
export { default as EventListing } from './EventListing.astro';
export { default as Feature } from './Feature.astro';
export { default as Hero } from './Hero.astro';
export { default as Navigation } from './Navigation.astro';
export { default as PageHeader } from './PageHeader.astro';
---

<!-- 
IMPORT STRATEGY GUIDE

For learning and single-component use (RECOMMENDED):
import { Badge } from 'accessible-astro-components';

For convenience when using many components:
import { Accordion, Card, Modal, Hero } from '@components/AccessibleComponents.astro';

For project-specific components:
import CallToAction from '@components/CallToAction.astro';

WHY DIRECT IMPORTS ARE BETTER:
- Tree shaking: Only bundles components you actually use
- Clarity: Obvious which library components come from  
- Learning: Encourages understanding of component APIs
- Performance: Smaller bundle sizes
- Maintenance: Easier to track component usage across the project

USE THIS FILE WHEN:
- Building complex demo pages that use many components
- Rapid prototyping where bundle size isn't critical
- You're certain you need most of the available components

For production campaign sites, prefer direct imports from 'accessible-astro-components'.
See docs/understanding-component-apis.md for detailed guidance.
-->