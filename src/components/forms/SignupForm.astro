---
// Generic signup form component for movement organizing
import FormBase from './FormBase.astro'
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  // Content customization
  title?: string
  subtitle?: string
  
  // Form behavior
  endpoint?: string
  successUrl?: string
  errorUrl?: string
  language?: string
  showProgress?: boolean
  
  // Field configuration
  requiredFields?: string[]
  optionalFields?: string[]
  
  // Styling
  variant?: 'default' | 'compact' | 'inline'
  className?: string
}

const {
  // Content
  title = 'Join Our Movement',
  subtitle = 'Add your name to join our community working for change.',
  
  // Form config
  endpoint,
  successUrl,
  errorUrl,
  language = 'en',
  showProgress = false,
  
  // Fields
  requiredFields = ['email'],
  optionalFields = ['name', 'phone', 'postal_code'],
  
  // Styling
  variant = 'default',
  className = '',
  
  ...containerProps
} = Astro.props

// Field labels - easily customizable for different languages/contexts
const labels = {
  name: 'Full Name',
  email: 'Email Address',
  phone: 'Phone Number',
  postal_code: 'Postal/Zip Code',
  submit: 'Join Us'
}

// Placeholders
const placeholders = {
  name: 'Your name',
  email: 'you@example.com',
  phone: '(555) 123-4567',
  postal_code: 'A1A 1A1 or 12345'
}

const allFields = [...requiredFields, ...optionalFields]
const formClasses = [
  'signup-form',
  `variant-${variant}`,
  className
].filter(Boolean).join(' ')
---

<div class={`signup-container ${variant}`} {...containerProps}>
  {variant !== 'inline' && (
    <div class="form-header">
      <h2 class="form-title">{title}</h2>
      {subtitle && <p class="form-subtitle">{subtitle}</p>}
    </div>
  )}
  
  <FormBase
    formType="signup"
    endpoint={endpoint}
    successUrl={successUrl}
    errorUrl={errorUrl}
    language={language}
    showProgress={showProgress}
    className={formClasses}
  >
    <div class="form-fields">
      {allFields.includes('name') && (
        <div class="field-group">
          <label for="name" class="field-label">
            {labels.name}
            {requiredFields.includes('name') && (
              <span class="required-asterisk" aria-label="required">*</span>
            )}
          </label>
          <input
            id="name"
            name="name"
            type="text"
            class="field-input"
            placeholder={placeholders.name}
            autocomplete="name"
            maxlength="120"
            required={requiredFields.includes('name')}
          />
        </div>
      )}

      {allFields.includes('email') && (
        <div class="field-group">
          <label for="email" class="field-label required">
            {labels.email}
            {requiredFields.includes('email') && (
              <span class="required-asterisk" aria-label="required">*</span>
            )}
          </label>
          <input
            id="email"
            name="email"
            type="email"
            class="field-input"
            placeholder={placeholders.email}
            autocomplete="email"
            spellcheck="false"
            maxlength="320"
            required={requiredFields.includes('email')}
          />
        </div>
      )}

      {allFields.includes('phone') && (
        <div class="field-group">
          <label for="phone" class="field-label">
            {labels.phone}
            {requiredFields.includes('phone') && (
              <span class="required-asterisk" aria-label="required">*</span>
            )}
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            class="field-input"
            placeholder={placeholders.phone}
            autocomplete="tel"
            maxlength="32"
            required={requiredFields.includes('phone')}
          />
        </div>
      )}

      {allFields.includes('postal_code') && (
        <div class="field-group">
          <label for="postal_code" class="field-label">
            {labels.postal_code}
            {requiredFields.includes('postal_code') && (
              <span class="required-asterisk" aria-label="required">*</span>
            )}
          </label>
          <input
            id="postal_code"
            name="postal_code"
            type="text"
            class="field-input"
            placeholder={placeholders.postal_code}
            autocomplete="postal-code"
            maxlength="16"
            required={requiredFields.includes('postal_code')}
          />
        </div>
      )}
    </div>

    <div class="form-actions">
      <button type="submit" class="submit-button primary">
        {labels.submit}
      </button>
    </div>

    {variant !== 'compact' && (
      <p class="form-note">
        Fields marked with * are required
      </p>
    )}
  </FormBase>
</div>

<style lang="scss">
  .signup-container {
    width: 100%;
    max-width: 500px;
    
    &.compact {
      max-width: 400px;
      
      .form-fields {
        gap: 1rem;
      }
      
      .field-input {
        padding: 0.5rem 0.75rem;
      }
    }
    
    &.inline {
      .form-fields {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: end;
        
        .field-group {
          flex: 1;
          min-width: 200px;
        }
      }
      
      .form-actions {
        margin-top: 0;
        margin-left: 1rem;
      }
    }
  }
  
  .form-header {
    margin-bottom: 2rem;
    text-align: center;
    
    .compact & {
      margin-bottom: 1.5rem;
    }
  }
  
  .form-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-primary-900, #1f2937);
    margin-bottom: 0.5rem;
    
    .compact & {
      font-size: 1.5rem;
    }
  }
  
  .form-subtitle {
    color: var(--color-neutral-600, #6b7280);
    font-size: 1.125rem;
    margin: 0;
    
    .compact & {
      font-size: 1rem;
    }
  }
  
  .form-fields {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .field-label {
    font-weight: 500;
    color: var(--color-neutral-900, #111827);
    font-size: 0.875rem;
    
    &.required {
      .required-asterisk {
        color: var(--color-error-500, #ef4444);
        margin-left: 0.25rem;
      }
    }
  }
  
  .field-input {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-neutral-300, #d1d5db);
    border-radius: 0.375rem;
    font-size: 1rem;
    transition: all 0.2s ease;
    background: white;
    
    &:focus {
      outline: none;
      border-color: var(--color-primary-500, #3b82f6);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }
    
    &.field-error {
      border-color: var(--color-error-500, #ef4444);
      
      &:focus {
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.1);
      }
    }
    
    &::placeholder {
      color: var(--color-neutral-500, #6b7280);
    }
  }
  
  .field-error-message {
    font-size: 0.875rem;
    color: var(--color-error-600, #dc2626);
    margin-top: 0.25rem;
  }
  
  .form-actions {
    margin-bottom: 1rem;
  }
  
  .submit-button {
    width: 100%;
    padding: 0.875rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    transition: all 0.2s ease;
    
    &.primary {
      background: var(--color-primary-600, #2563eb);
      color: white;
      
      &:hover:not(:disabled) {
        background: var(--color-primary-700, #1d4ed8);
      }
      
      &:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
      }
      
      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    }
    
    .inline & {
      width: auto;
      white-space: nowrap;
    }
  }
  
  .form-note {
    font-size: 0.875rem;
    color: var(--color-neutral-600, #6b7280);
    text-align: center;
    margin: 0;
  }
  
  // Responsive adjustments
  @media (max-width: 640px) {
    .signup-container.inline {
      .form-fields {
        flex-direction: column;
        align-items: stretch;
      }
      
      .form-actions {
        margin-left: 0;
        margin-top: 1.5rem;
      }
      
      .submit-button {
        width: 100%;
      }
    }
  }
</style>