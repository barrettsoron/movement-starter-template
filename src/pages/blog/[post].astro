import { Image } from 'astro:assets'

export async function getStaticPaths() {
  const data = await fetch('https://jsonplaceholder.typicode.com/posts').then((response) => response.json())

  const postImages = [
    { src: 'https://images.unsplash.com/photo-1517048676732-d65bc937f952?w=800&h=500&fit=crop' },
    { src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?w=800&h=500&fit=crop' },
    { src: 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&h=500&fit=crop' },
    { src: 'https://images.unsplash.com/photo-1556761175-5973dc0f32e7?w=800&h=500&fit=crop' },
    { src: 'https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800&h=500&fit=crop' },
    { src: 'https://images.unsplash.com/photo-1531206715517-5c0ba140b2b8?w=800&h=500&fit=crop' },
  ]

  function truncateTitle(title) {
    const words = title.split(' ')
    const truncated = words.slice(0, 4).join(' ')
    return {
      full: title,
      truncated: truncated,
    }
  }

  return data.map((post) => {
    const titleObj = truncateTitle(post.title)

    const postWithImage = {
      ...post,
      featuredImage: postImages[post.id % postImages.length].src,
      title: titleObj.truncated,
    }

    return {
      params: { post: titleObj.truncated.replaceAll(' ', '-').toLowerCase() },
      props: { post: postWithImage },
    }
  })
}

const { post } = Astro.props
const author = {
  name: 'Movement Organizer',
  image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop',
  bio: 'Passionate community organizer and campaign strategist',
}
