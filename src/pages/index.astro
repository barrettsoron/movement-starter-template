---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import ContentMedia from '@components/ContentMedia.astro'
import ExternalLink from '@components/ExternalLink.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup } from 'accessible-astro-components'
---

<DefaultLayout title="Home">
  <Hero />
  <section class="my-64">
    <div class="container">
      <h2 class="mb-16 text-6xl">Skip the Setup Headaches</h2>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
        <Feature icon="ph:users-three" title="Accessible by Default">
          Never worry about ADA compliance or excluding users. Keyboard navigation, screen readers, and mobile support work out of the box.
        </Feature>
        <Feature icon="ph:toolbox" title="Content Collections Ready">
          Stories, events, and updates pre-configured with proper schemas. Add content in Markdown—no database setup required.
        </Feature>
        <Feature icon="ph:moon" title="Dark Mode Included">
          Automatic theme switching reduces eye strain during long work sessions. Respects user preferences without extra code.
        </Feature>
        <Feature icon="ph:paint-brush" title="Environment-Based Config">
          Change site name, colors, and features with environment variables. No code changes needed for different deployments.
        </Feature>
        <Feature icon="ph:rocket-launch" title="Deploy in Minutes">
          Connect to Netlify, set environment variables, and you're live. Staging and production environments configured automatically.
        </Feature>
        <Feature icon="ph:shield-check" title="Security Headers Built-In">
          CSP, HTTPS enforcement, and privacy-focused defaults protect you from common vulnerabilities without security expertise.
        </Feature>
        <Feature icon="ph:megaphone" title="Performance Optimized">
          Static site generation handles traffic spikes without expensive servers. Your site stays up when it goes viral.
        </Feature>
        <Feature icon="ph:article" title="Markdown Content">
          Write in Markdown, no CMS complexity. Content editors can add stories and events without touching code.
        </Feature>
        <Feature icon="ph:stack" title="Component Library">
          Pre-built accessible components save development time. Copy-paste patterns that actually work across devices.
        </Feature>
      </div>
    </div>
  </section>
  <ContentMedia imgSrc="https://images.unsplash.com/photo-1501386761578-eac5c94b800a?w=800&h=600&fit=crop&auto=format&q=80" alt="Diverse crowd of people at an outdoor community gathering or rally">
    <h2>Movement-Ready Components</h2>
    <p class="text-2xl">
      Pre-built components designed for organizing: event listings with RSVP, story collection forms, donation buttons, volunteer signup, action alerts, and contact-your-representative tools. All accessible and ready to deploy.
    </p>
  </ContentMedia>
  <ContentMedia imgSrc="https://images.unsplash.com/photo-1713977331599-6e36f9faca84?w=800&h=600&fit=crop&auto=format&q=80" alt="Person using assistive technology or accessible interface" reverseImg={true}>
    <h2>Accessible to All</h2>
    <p class="text-2xl">
      Every community member can participate fully - screen reader users, keyboard navigators, people with visual impairments, and those with cognitive differences. True accessibility means inclusive movements.
    </p>
  </ContentMedia>
  <section class="my-64">
    <div class="container grid grid-cols-1 gap-12 md:grid-cols-2">
      <div class="flex flex-col items-start gap-4">
        <h2 class="text-6xl">Getting Started</h2>
        <p class="text-2xl">
          Common questions about building movement websites, rapid deployment, and organizing with digital tools.
        </p>
        <a class="button" href="/components-demo">View All Components</a>
      </div>
      <div class="space-content">
        <Accordion>
          <AccordionItem name="exclusive" title="How quickly can I deploy a campaign site?" open>
            <p>
              With environment variables configured, you can deploy a fully-functional campaign website in under 10 minutes. The template includes event listings, donation forms, story collection, and volunteer signup - all the essential organizing tools ready to go.
            </p>
          </AccordionItem>
          <AccordionItem name="exclusive" title="Is this secure enough for sensitive organizing?">
            <p>
              Yes! The template includes HTTPS enforcement, secure form handling, privacy-focused analytics options, and follows security best practices for protecting organizer and supporter data. Perfect for campaigns facing opposition or surveillance concerns.
            </p>
          </AccordionItem>
          <AccordionItem name="exclusive" title="Can I customize it without coding knowledge?">
            <p>
              Absolutely. Most customization happens through environment variables - change colors, site name, contact info, and feature toggles without touching code. Content is managed through simple Markdown files that anyone can edit.
            </p>
          </AccordionItem>
          <AccordionItem name="exclusive" title="What organizing tools are included?">
            <p>
              Event listings with RSVP, story collection forms, donation integration, volunteer signup, action alerts, contact-your-representative tools, campaign updates/blog, and community member profiles. All components are accessibility-tested.
            </p>
          </AccordionItem>
          <AccordionItem name="exclusive" title="How do I handle multiple languages?">
            <p>
              The template supports internationalization out of the box. Create parallel content structures for different languages, and the routing system will handle language switching automatically. Perfect for diverse communities and coalition organizing.
            </p>
          </AccordionItem>
        </Accordion>
      </div>
    </div>
  </section>
  <section class="my-64">
    <div class="space-content container">
      <h2 class="text-6xl">Built by Organizers</h2>
      <p class="text-2xl">
        Created by campaigners and movement builders who understand the urgency of deployment, the importance of accessibility, and the need for tools that work under pressure.
      </p>
      <AvatarGroup display="grid" gridItemsSize="300px" gridGap="2rem">
        <Avatar initials="MB" title="Mike Barrett Soron" subtitle="Template Author" />
        <Avatar initials="CL" title="Campaign Lead" subtitle="Field Organizer" />
        <Avatar initials="VS" title="Volunteer Coordinator" subtitle="Community Builder" />
        <Avatar initials="DC" title="Digital Strategist" subtitle="Communications" />
        <Avatar initials="PO" title="Policy Organizer" subtitle="Legislative Affairs" />
        <Avatar initials="AR" title="Action Researcher" subtitle="Data Analysis" />
        <Avatar initials="CS" title="Coalition Specialist" subtitle="Partnership Building" />
        <Avatar initials="EO" title="Events Organizer" subtitle="Mobilization" />
        <Avatar initials="SO" title="Social Media" subtitle="Online Engagement" />
      </AvatarGroup>
    </div>
  </section>
  <section class="mt-64 mb-32">
    <div class="container">
      <h2 class="mb-16 text-6xl">Movement Impact</h2>
      <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 md:grid-cols-4">
        <Counter count="150+" title="Campaigns" sub="Deployed" />
        <Counter count="25+" title="Organizing" sub="Tools" />
        <Counter count="10K+" title="Volunteers" sub="Mobilized" />
        <Counter count="$2M+" title="Raised" sub="For movements" />
      </div>
    </div>
  </section>
</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }
</style>
