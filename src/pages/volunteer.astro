---
// Generic volunteer page demonstrating VolunteerForm usage
import DefaultLayout from '@layouts/DefaultLayout.astro'
import VolunteerForm from '@components/forms/VolunteerForm.astro'
import { siteConfig } from '../site.config.js'

const seo = {
  title: `Volunteer - ${siteConfig.name}`,
  description: `Volunteer with ${siteConfig.name} and help build our movement. Your time and skills can make a real difference in creating positive change.`,
}
---

<DefaultLayout {seo}>
  <section class="my-32">
    <div class="container">
      <div class="space-content text-center">
        <h1>Volunteer With Us</h1>
        <p class="lead">
          Ready to turn your passion into action? Join our volunteer team and help build the movement for change.
        </p>
      </div>
    </div>
  </section>
  
  <section class="my-16">
    <div class="container">
      <div class="form-container">
        <VolunteerForm 
          title="Join Our Team"
          subtitle="Help us build a better future together"
          requiredFields={['first_name', 'last_name', 'email']}
          optionalFields={['phone', 'address_1', 'postal', 'availability', 'skills', 'languages']}
          customQuestions={[
            {
              id: 'experience',
              label: 'What experience do you bring to our movement?',
              type: 'textarea',
              required: false
            },
            {
              id: 'motivation',
              label: 'What motivates you to volunteer with us?',
              type: 'textarea',
              required: false
            }
          ]}
        />
      </div>
    </div>
  </section>
  
  <section class="my-32">
    <div class="container">
      <div class="space-content">
        <h2 class="text-center">How You Can Make a Difference</h2>
        <div class="volunteer-opportunities">
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">🏛️</div>
            <h3>Community Organizing</h3>
            <p>Help organize events, coordinate volunteers, and build relationships in your local community to create lasting change.</p>
            <ul>
              <li>Event planning and coordination</li>
              <li>Volunteer recruitment and management</li>
              <li>Community partnership building</li>
            </ul>
          </div>
          
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">📱</div>
            <h3>Digital Outreach</h3>
            <p>Use digital tools and social media to spread our message, engage supporters, and build online communities.</p>
            <ul>
              <li>Social media management</li>
              <li>Content creation and copywriting</li>
              <li>Email campaign development</li>
            </ul>
          </div>
          
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">🎨</div>
            <h3>Creative & Communications</h3>
            <p>Help create compelling visual content, write persuasive messaging, and design materials that inspire action.</p>
            <ul>
              <li>Graphic design and visual branding</li>
              <li>Video production and editing</li>
              <li>Copywriting and messaging</li>
            </ul>
          </div>
          
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">📊</div>
            <h3>Research & Analysis</h3>
            <p>Support our work with data analysis, policy research, and strategic planning to ensure our efforts are effective.</p>
            <ul>
              <li>Policy research and analysis</li>
              <li>Data collection and interpretation</li>
              <li>Strategic planning support</li>
            </ul>
          </div>
          
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">🤝</div>
            <h3>Direct Action & Advocacy</h3>
            <p>Participate in rallies, protests, lobbying efforts, and other direct actions to advocate for our causes.</p>
            <ul>
              <li>Event participation and support</li>
              <li>Advocacy and lobbying</li>
              <li>Public speaking and representation</li>
            </ul>
          </div>
          
          <div class="opportunity">
            <div class="opportunity-icon" aria-hidden="true">⚙️</div>
            <h3>Operations & Support</h3>
            <p>Keep our organization running smoothly with administrative support, logistics coordination, and operational assistance.</p>
            <ul>
              <li>Administrative and office support</li>
              <li>Database management</li>
              <li>Logistics and coordination</li>
            </ul>
          </div>
        </div>
        
        <div class="commitment-info">
          <h3>Flexible Commitment Levels</h3>
          <p>
            We welcome volunteers of all availability levels. Whether you have 2 hours a month or 20 hours a week, 
            there's a meaningful way for you to contribute to our movement.
          </p>
          
          <div class="time-options">
            <div class="time-option">
              <h4>Occasional Volunteer</h4>
              <div class="time-badge">2-4 hours/month</div>
              <ul>
                <li>Event support and participation</li>
                <li>Social media sharing and engagement</li>
                <li>Flexible, project-based assistance</li>
              </ul>
            </div>
            <div class="time-option">
              <h4>Regular Volunteer</h4>
              <div class="time-badge">2-5 hours/week</div>
              <ul>
                <li>Ongoing project involvement</li>
                <li>Team collaboration and meetings</li>
                <li>Skill-specific contributions</li>
              </ul>
            </div>
            <div class="time-option">
              <h4>Core Team Member</h4>
              <div class="time-badge">10+ hours/week</div>
              <ul>
                <li>Leadership and coordination roles</li>
                <li>Strategic planning participation</li>
                <li>Mentoring newer volunteers</li>
              </ul>
            </div>
          </div>
        </div>
        
        <div class="support-info">
          <h3>We Support Our Volunteers</h3>
          <div class="support-grid">
            <div class="support-item">
              <div class="support-icon" aria-hidden="true">🎓</div>
              <h4>Training & Development</h4>
              <p>Comprehensive orientation and ongoing skills development to help you succeed in your volunteer role.</p>
            </div>
            <div class="support-item">
              <div class="support-icon" aria-hidden="true">👥</div>
              <h4>Community & Connection</h4>
              <p>Join a welcoming community of dedicated volunteers working together toward common goals.</p>
            </div>
            <div class="support-item">
              <div class="support-icon" aria-hidden="true">🛠️</div>
              <h4>Resources & Tools</h4>
              <p>Access to the tools, resources, and support you need to be effective in your volunteer work.</p>
            </div>
            <div class="support-item">
              <div class="support-icon" aria-hidden="true">🏆</div>
              <h4>Recognition & Growth</h4>
              <p>Recognition for your contributions and opportunities to take on new challenges and leadership roles.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .lead {
    font-size: 1.25rem;
    color: var(--color-neutral-600, #4b5563);
    max-width: 600px;
    margin: 0 auto 2rem auto;
  }
  
  .form-container {
    display: flex;
    justify-content: center;
    padding: 2rem;
    background: var(--color-neutral-25, #fefefe);
    border-radius: 1rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
  }
  
  .volunteer-opportunities {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin: 2rem 0 3rem 0;
  }
  
  .opportunity {
    background: white;
    padding: 2rem;
    border-radius: 0.75rem;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.1);
    border-left: 4px solid var(--color-primary-500, #3b82f6);
    
    .opportunity-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    
    h3 {
      color: var(--color-primary-700, #1d4ed8);
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }
    
    p {
      color: var(--color-neutral-600, #4b5563);
      margin-bottom: 1rem;
      line-height: 1.6;
    }
    
    ul {
      list-style: none;
      padding: 0;
      margin: 0;
      
      li {
        padding: 0.25rem 0;
        color: var(--color-neutral-700, #374151);
        font-size: 0.875rem;
        
        &:before {
          content: '✓';
          color: var(--color-primary-600, #2563eb);
          font-weight: bold;
          margin-right: 0.5rem;
        }
      }
    }
  }
  
  .commitment-info, .support-info {
    background: var(--color-neutral-50, #f9fafb);
    padding: 2.5rem;
    border-radius: 0.75rem;
    margin: 3rem 0;
    
    h3 {
      color: var(--color-primary-800, #1e40af);
      font-size: 1.5rem;
      font-weight: 600;
      margin-bottom: 1rem;
      text-align: center;
    }
    
    > p {
      color: var(--color-neutral-700, #374151);
      font-size: 1.125rem;
      line-height: 1.6;
      margin-bottom: 2rem;
      text-align: center;
    }
  }
  
  .time-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  
  .time-option {
    background: white;
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-neutral-200, #e5e7eb);
    position: relative;
    
    h4 {
      color: var(--color-primary-700, #1d4ed8);
      font-size: 1.125rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    
    .time-badge {
      background: var(--color-primary-100, #dbeafe);
      color: var(--color-primary-800, #1e40af);
      font-size: 0.875rem;
      font-weight: 500;
      padding: 0.25rem 0.75rem;
      border-radius: 1rem;
      display: inline-block;
      margin-bottom: 1rem;
    }
    
    ul {
      list-style: none;
      padding: 0;
      margin: 0;
      
      li {
        padding: 0.25rem 0;
        color: var(--color-neutral-600, #4b5563);
        font-size: 0.875rem;
        
        &:before {
          content: '•';
          color: var(--color-primary-600, #2563eb);
          font-weight: bold;
          margin-right: 0.5rem;
        }
      }
    }
  }
  
  .support-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  
  .support-item {
    background: white;
    padding: 1.5rem;
    border-radius: 0.5rem;
    text-align: center;
    border: 1px solid var(--color-neutral-200, #e5e7eb);
    
    .support-icon {
      font-size: 2rem;
      margin-bottom: 1rem;
    }
    
    h4 {
      color: var(--color-primary-700, #1d4ed8);
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
    
    p {
      color: var(--color-neutral-600, #4b5563);
      font-size: 0.875rem;
      margin: 0;
      line-height: 1.5;
    }
  }
  
  @media (max-width: 768px) {
    .volunteer-opportunities {
      grid-template-columns: 1fr;
    }
    
    .time-options {
      grid-template-columns: 1fr;
    }
  }
</style>