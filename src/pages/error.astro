---
// Generic error page for form submissions
import DefaultLayout from '@layouts/DefaultLayout.astro'
import { Card } from 'accessible-astro-components'
import { siteConfig } from '@/site.config'

// Get form type from query parameters to customize message
const url = new URL(Astro.request.url)
const formType = url.searchParams.get('type') || 'form'

const messages = {
  signup: {
    title: 'Signup Issue',
    message: 'We encountered an issue processing your signup. This is usually temporary.',
    suggestions: [
      'Double-check your email address format',
      'Try refreshing the page and submitting again',
      'Contact us if the problem persists'
    ]
  },
  volunteer: {
    title: 'Volunteer Application Issue',
    message: 'There was a problem processing your volunteer application. We want to make sure we don\'t miss your interest in helping.',
    suggestions: [
      'Check that all required fields are filled out',
      'Try submitting your application again',
      'Email us directly if you continue having issues'
    ]
  },
  newsletter: {
    title: 'Newsletter Subscription Issue', 
    message: 'We couldn\'t complete your newsletter subscription right now.',
    suggestions: [
      'Verify your email address is correct',
      'Try subscribing again in a few minutes',
      'Contact us to manually add you to our list'
    ]
  },
  form: {
    title: 'Form Submission Issue',
    message: 'We encountered an issue processing your form submission.',
    suggestions: [
      'Check your internet connection',
      'Try submitting the form again',
      'Contact us if the problem continues'
    ]
  }
}

const content = messages[formType] || messages.form

const seo = {
  title: `Error - ${siteConfig.name}`,
  description: content.message,
}
---

<DefaultLayout {seo}>
  <section class="my-64">
    <div class="container">
      <div class="space-content text-center">
        <Card>
          <div class="error-content">
            <div class="error-icon" aria-hidden="true">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
              </svg>
            </div>
            
            <h1>{content.title}</h1>
            
            <p class="lead">{content.message}</p>
            
            <div class="troubleshooting">
              <h2>What you can try:</h2>
              <ul class="suggestions-list">
                {content.suggestions.map((suggestion) => (
                  <li>{suggestion}</li>
                ))}
              </ul>
            </div>
            
            <div class="action-links">
              <button onclick="history.back()" class="button primary">
                Go Back and Try Again
              </button>
              
              <a href="/" class="button secondary">
                Return to Homepage
              </a>
              
              <a href={`mailto:${siteConfig.email}`} class="button outline">
                Contact Support
              </a>
            </div>
            
            <div class="contact-info">
              <p>
                <strong>Need immediate help?</strong><br>
                Email us at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
              </p>
            </div>
            
            <details class="technical-details">
              <summary>Technical Information</summary>
              <div class="tech-info">
                <p>
                  <strong>Time:</strong> <span id="error-time"></span><br>
                  <strong>Form Type:</strong> <span>{formType}</span><br>
                  <strong>Browser:</strong> <span id="user-agent"></span>
                </p>
                <p class="privacy-note">
                  This information can help our technical team diagnose the issue. 
                  No personal information from your form is stored here.
                </p>
              </div>
            </details>
          </div>
        </Card>
      </div>
    </div>
  </section>
</DefaultLayout>

<style lang="scss">
  .error-content {
    text-align: center;
    padding: 2rem;
    max-width: 600px;
    margin: 0 auto;
  }
  
  .error-icon {
    color: var(--color-error-600, #dc2626);
    margin-bottom: 1.5rem;
    
    svg {
      width: 64px;
      height: 64px;
      margin: 0 auto;
      display: block;
    }
  }
  
  h1 {
    color: var(--color-error-900, #7f1d1d);
    font-size: 2.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }
  
  .lead {
    font-size: 1.125rem;
    color: var(--color-neutral-700, #374151);
    margin-bottom: 2rem;
    line-height: 1.6;
  }
  
  .troubleshooting {
    text-align: left;
    margin-bottom: 2rem;
    background: var(--color-neutral-50, #f9fafb);
    border-radius: 0.5rem;
    padding: 1.5rem;
    border-left: 4px solid var(--color-warning-500, #f59e0b);
    
    h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--color-neutral-900, #111827);
      margin-bottom: 1rem;
      text-align: center;
    }
  }
  
  .suggestions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    
    li {
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--color-neutral-200, #e5e7eb);
      position: relative;
      padding-left: 1.5rem;
      
      &:last-child {
        border-bottom: none;
      }
      
      &:before {
        content: '→';
        position: absolute;
        left: 0;
        color: var(--color-warning-600, #d97706);
        font-weight: bold;
      }
    }
  }
  
  .action-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
    
    @media (min-width: 640px) {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    border: 2px solid transparent;
    background: none;
    cursor: pointer;
    font-size: 0.875rem;
    
    &.primary {
      background: var(--color-primary-600, #2563eb);
      color: white;
      border-color: var(--color-primary-600, #2563eb);
      
      &:hover {
        background: var(--color-primary-700, #1d4ed8);
        border-color: var(--color-primary-700, #1d4ed8);
        transform: translateY(-1px);
      }
    }
    
    &.secondary {
      background: var(--color-neutral-600, #4b5563);
      color: white;
      border-color: var(--color-neutral-600, #4b5563);
      
      &:hover {
        background: var(--color-neutral-700, #374151);
        border-color: var(--color-neutral-700, #374151);
        transform: translateY(-1px);
      }
    }
    
    &.outline {
      border-color: var(--color-neutral-400, #9ca3af);
      color: var(--color-neutral-700, #374151);
      background: transparent;
      
      &:hover {
        border-color: var(--color-primary-600, #2563eb);
        color: var(--color-primary-600, #2563eb);
      }
    }
  }
  
  .contact-info {
    font-size: 0.875rem;
    color: var(--color-neutral-600, #4b5563);
    margin-bottom: 2rem;
    
    a {
      color: var(--color-primary-600, #2563eb);
      text-decoration: none;
      
      &:hover {
        text-decoration: underline;
      }
    }
  }
  
  .technical-details {
    text-align: left;
    background: var(--color-neutral-100, #f3f4f6);
    border-radius: 0.375rem;
    padding: 1rem;
    
    summary {
      cursor: pointer;
      font-weight: 500;
      color: var(--color-neutral-700, #374151);
      
      &:hover {
        color: var(--color-primary-600, #2563eb);
      }
    }
    
    .tech-info {
      margin-top: 1rem;
      font-size: 0.875rem;
      font-family: monospace;
      
      span {
        word-break: break-all;
      }
    }
    
    .privacy-note {
      margin-top: 0.75rem;
      font-size: 0.75rem;
      color: var(--color-neutral-500, #6b7280);
      font-style: italic;
      font-family: sans-serif;
    }
  }
</style>

<script>
  // Populate technical details for debugging
  document.addEventListener('DOMContentLoaded', function() {
    const errorTimeEl = document.getElementById('error-time');
    const userAgentEl = document.getElementById('user-agent');
    
    if (errorTimeEl) {
      errorTimeEl.textContent = new Date().toLocaleString();
    }
    
    if (userAgentEl) {
      userAgentEl.textContent = navigator.userAgent;
    }
  });
</script>